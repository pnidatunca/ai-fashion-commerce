DATABASE_URL=your_neon_postgresql_connection_string
GEMINI_API_KEY=your_gemini_api_key

# /ml/interactions ucunu acar. Tanimli degilse uc kapalidir (503).
# Rastgele uzun bir deger uret: python -c "import secrets; print(secrets.token_urlsafe(32))"
ML_EXPORT_TOKEN=

# AI sohbet asistaninin TERCIH EDILEN modeli (/api/chat).
#
# Bos birakilabilir. Asistan tek bir modele bagli degil, sirali
# bir liste deniyor (assistant.DEFAULT_MODEL_CHAIN):
#
#     gemini-3.5-flash  ->  gemini-3.5-flash-lite
#                       ->  gemini-3.1-flash-lite
#
# Ucretsiz katmanda kota MODEL BASINA ayri ve dakikada 5 istek.
# Her sohbet turu 2 istek harciyor, yani dakikada ~2 mesaj.
# Biri tukenince digerine geciliyor; hepsi tukenirse kullaniciya
# ne kadar bekleyecegi soyleniyor (HTTP 429).
#
# Buraya bir model yazarsan o BASA alinir, yedekler yine durur.
# Kullanilabilir modelleri gormek icin: python list_models.py
#
# NOT: gercek kullanim icin ucretli plan gerekiyor. Ucretsiz
# katman gelistirme ve demo icin yeterli, canli site icin degil.
CHAT_MODEL=

# Asistanin diger ayarlari da ortamdan okunabiliyor; hepsi
# istege bagli ve bos birakilirsa varsayilan kullanilir:
#
#     CHAT_MODEL_CHAIN        virgullu model listesi
#     CHAT_CALL_TIMEOUT       cagri basina sinir (sn, varsayilan 10;
#                             Gemini 10'un altini reddediyor)
#     CHAT_LAST_CALL_TIMEOUT  son deneme siniri (sn, varsayilan 25)
#     CHAT_STREAM_TIMEOUT     akis siniri (sn, varsayilan 60)
#     CHAT_COOLDOWN           hata alan modelin soguma suresi (sn)
#     CHAT_TEMPERATURE
#     CHAT_MAX_TOOL_ROUNDS    model->arac->model turu ust siniri
#     CHAT_MAX_HISTORY        modele gonderilen son N mesaj
#     CHAT_MAX_CARDS          bir cevapta en fazla kac urun karti
#
# Ayrintili aciklamalar: packages/toolchat/README.md
